{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-biz-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the @thomasfosterau/effect-biz package family: modular ERP and business-process services for Effect, with a vendor-neutral payments core and a Stripe provider.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint --tsrs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@thomasfosterau/effect-biz": "workspace:*",
    "@thomasfosterau/effect-biz-payments-stripe": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.21.0"
}
