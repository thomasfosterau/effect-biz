{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // A test may import this package by its own name, as a consumer would;
    // the mapping resolves that name to `src/` so the type gate never needs
    // this package's `dist/` first (vite.package.ts aliases it the same way
    // for the test runner). Siblings resolve through `exports` to `dist/`.
    // Relative to this file; TypeScript 7 removed `baseUrl`.
    //
    // The core sibling ALSO resolves to its `src/` here, so type-aware lint
    // (oxlint-tsgolint, which reads this file and runs before any build in CI)
    // never depends on `packages/core/dist`. The type gate keeps consuming
    // the core through `dist/`: `tsconfig.check.json` drops that mapping.
    "paths": {
      "@thomasfosterau/effect-biz-payments-stripe": ["./src/index.ts"],
      "@thomasfosterau/effect-biz-payments-stripe/*": ["./src/*.ts"],
      "@thomasfosterau/effect-biz": ["../core/src/index.ts"],
      "@thomasfosterau/effect-biz/*": ["../core/src/*.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts"]
}
